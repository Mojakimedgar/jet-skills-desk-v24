# JET Skills Desk email notification settings
JET_CONTACT_NAME=Papie Mojaki
JET_CONTACT_PHONE=0738643876
JET_CONTACT_EMAIL=Mojaki.P@Dhet.gov.za
JET_CONTACT_ORGANISATION=JET Skills Desk

# Microsoft Graph application settings - obtain from your Microsoft 365 / Entra administrator
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAIL_SENDER=

# OpenAI (optional). Leave OPENAI_API_KEY empty to use the built-in FAQ answers only.
# Create a key at https://platform.openai.com/api-keys  (never commit .env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phase 2: lets you trigger a harvest from the web (POST /api/harvest/refresh with header X-Admin-Token).
# Leave empty to disable web-triggered refresh; the command line (python harvester.py refresh) always works.
HARVEST_ADMIN_TOKEN=
