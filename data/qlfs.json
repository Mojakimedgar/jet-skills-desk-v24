  "code_list_url": "https://www.statssa.gov.za/?page_id=4528",
  "workbook": "JET_Priority_Occupations_QLFS_Data_version2.xlsx"
 },
 "methodology": [
  {
   "item": "Dataset",
   "definition": "South Africa Quarterly Labour Force Survey (QLFS), Q2 2026"
  },
  {
   "item": "Source",
   "definition": "Statistics South Africa."
  },
  {
   "item": "Employment status",
   "definition": "Lfs_Status = 1 Employed; Lfs_Status = 2 Unemployed."
  },
  {
   "item": "Employed occupation",
   "definition": "Q42OCCUPATION (4-digit QLFS occupation code)."
  },
  {
   "item": "Unemployed occupation",
   "definition": "Q315PREVOCCUPATION (previous occupation), because unemployed respondents do not have a current occupation."
  },
  {
   "item": "Province",
   "definition": "Province codes 1–9 correspond to Western Cape, Eastern Cape, Northern Cape, Free State, KwaZulu-Natal, North West, Gauteng, Mpumalanga and Limpopo."
  },
  {
   "item": "Mapping note",
   "definition": "QLFS occupation categories do not always provide a one-to-one match to every 6-digit OFO priority occupation. Where no exact 4-digit QLFS category exists, the workbook uses a clearly flagged closest/proxy category. These proxy mappings should be reviewed before using them for formal occupational-demand estimates."
  },
  {
   "item": "Unemployment interpretation",
   "definition": "Unemployment figures represent unemployed people whose previous occupation falls in the selected QLFS occupation category; they should not be interpreted as current vacancies or current occupational employment."
  }
 ],
 "caveats": [
  "A figure of 0 means no figure is reported for that province in the workbook. The workbook does not say whether it is a true zero or too few survey respondents to estimate, so do not read 0 as 'no workers'.",
  "Several priority occupations share one QLFS category, so they show identical figures. Do not add occupations together: the same people would be counted more than once.",
  "Employment is by current occupation. Unemployment is by previous occupation, so it is not a count of vacancies or of people currently seeking one particular job.",
  "Closest/proxy matches are approximations and, as the workbook notes, should be reviewed before use in formal occupational-demand estimates."
 ],
